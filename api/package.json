{
    "name": "@tak-ps/CloudTAK.api",
    "type": "module",
    "version": "14.4.0",
    "description": "Facilitate ETL operations to bring non-TAK sources into a TAK Server",
    "main": "index.js",
    "scripts": {
        "test": "StackName='test' tsx --test --test-concurrency=8 --test-force-exit --test-timeout=60000 test/*.test.ts",
        "precoverage": "mkdir -p dist/test/fixtures/ && mkdir -p dist/test/data/ && cp test/fixtures/* dist/test/fixtures/ && cp test/data/* dist/test/data/ && npm run build",
        "coverage": "StackName='test' c8 --reporter=lcov --reporter html node --test --test-concurrency=8 --test-force-exit --test-timeout=60000 dist/test/*.test.js",
        "build": "tsc && (cp .env* dist/ || true) && cp ./icons dist/icons -r && cp ./branding dist/branding -r && cp package.json dist/ && cp migrations/ dist/ -r",
        "typegen": "openapi-typescript http://localhost:5001/api/swagger --output derived-types.d.ts",
        "lint": "oxlint --type-aware index.ts common/ stateful/ stateless/ test/",
        "emptydb": "psql -v ON_ERROR_STOP=1 -c 'DROP DATABASE IF EXISTS tak_ps_etl' -c 'CREATE DATABASE tak_ps_etl'",
        "loaddb": "npm run emptydb && psql -v ON_ERROR_STOP=1 tak_ps_etl < ",
        "migratedb": "tsx ./node_modules/.bin/drizzle-kit generate && npm run migratedb-commit",
        "migratedb-custom": "npm run migratedb-pre && tsx ./node_modules/.bin/drizzle-kit generate --custom && npm run migratedb-commit",
        "migratedb-pre": "npm run lint && git stash && tsc --outDir .",
        "migratedb-commit": "git add migrations/* && git commit -m 'Custom DB Migration'",
        "dev": "tsx watch index.ts --no-events --no-etl-events --no-geofence --no-connections",
        "prod": "NODE_OPTIONS='--max-old-space-size=6144' node dist/index.js"
    },
    "engines": {
        "node": ">= 24"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dfpc-coe/CloudTAK.git"
    },
    "author": "Nick Ingalls <nick@ingalls.ca>",
    "license": "AGPL-3.0-only",
    "dependencies": {
        "@archiver/archiver": "^0.3.0",
        "@aws-sdk/client-cloudformation": "^3.279.0",
        "@aws-sdk/client-cloudwatch": "^3.279.0",
        "@aws-sdk/client-cloudwatch-logs": "^3.423.0",
        "@aws-sdk/client-ecr": "^3.279.0",
        "@aws-sdk/client-lambda": "^3.280.0",
        "@aws-sdk/client-s3": "^3.279.0",
        "@aws-sdk/client-secrets-manager": "^3.279.0",
