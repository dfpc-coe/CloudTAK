{
    "name": "pmtiles-aws",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">= 26"
    },
    "scripts": {
        "check": "tsc --noEmit --project tsconfig.json",
        "lint": "oxlint --type-aware index.ts routes/ test/ lib/",
        "test": "tsx --test test/*.test.ts",
        "coverage": "c8 --reporter=lcov --reporter=text tsx --test test/*.test.ts",
        "typegen": "openapi-typescript http://localhost:5002/openapi --output derived-types.d.ts",
        "build": "tsc --project tsconfig.json",
        "dev": "tsx watch index.ts --noevents --nometrics --nosinks --unsafe",
        "prod": "NODE_OPTIONS='--max-old-space-size=6144' node dist/index.js"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.726.1",
        "@aws-sdk/client-secrets-manager": "^3.726.1",
        "@aws-sdk/node-http-handler": "^3.212.0",
        "@mapbox/tile-cover": "^3.0.2",
        "@mapbox/vector-tile": "^3.0.0",
        "@mapbox/vtquery": "^0.6.0",
        "@maplibre/geojson-vt": "^7.0.1",
        "@openaddresses/batch-error": "^2.9.0",
        "@openaddresses/batch-schema": "^10.12.1",
        "@sinclair/typebox": "^0.34.11",
        "@supercharge/promise-pool": "^3.2.0",
        "@tak-ps/node-safeurl": "^1.4.0",
        "@tak-ps/node-tiles": "^1.2.1",
        "@tak-ps/serverless-http": "^3.4.0",
        "@turf/along": "^7.3.5",
        "@turf/distance": "^7.3.5",
        "@turf/helpers": "^7.3.5",
        "@types/mapbox__tile-cover": "^3.0.4",
        "@types/mapbox__vector-tile": "^1.3.4",
        "cors": "^2.8.5",
        "esri-dump": "^6.6.0",
        "express": "^5.0.0",
        "jsonwebtoken": "^9.0.0",
        "pbf": "^5.0.0",
        "pmtiles": "^4.0.0",
        "sharp": "^0.35.0",
        "undici": "^8.12.3",
        "vt-pbf": "^3.1.3"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/geojson": "^7946.0.16",
        "@types/jsonwebtoken": "^9.0.2",
        "@types/node": "^26.0.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "c8": "^12.0.0",
        "openapi-typescript": "^7.13.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2008",
        "tsx": "^4.21.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
