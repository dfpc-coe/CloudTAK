{
    "name": "retention-service",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">= 24"
    },
    "scripts": {
        "typegen": "npm run typegen -C ../../api",
        "check": "tsc --noEmit",
        "lint": "oxlint --type-aware src/ test/",
        "test": "StackName='test' tsx --test test/*.test.ts",
        "coverage": "StackName='test' c8 --reporter=lcov --reporter=text tsx --test test/*.test.ts",
        "build": "tsup --target es2022 --format esm src/",
        "dev": "tsx watch src/index.ts --noevents --nometrics --nosinks --unsafe",
        "prod": "NODE_OPTIONS='--max-old-space-size=6144' node dist/index.js",
        "run-once": "NODE_OPTIONS='--max-old-space-size=6144' node dist/index.js --run-once"
    },
    "dependencies": {
        "jsonwebtoken": "^9.0.0",
        "node-cron": "^4.2.1"
    },
    "devDependencies": {
        "@types/jsonwebtoken": "^9.0.0",
        "@types/node": "^26.0.0",
        "@typescript/native": "npm:typescript@^7.0.2",
        "c8": "^12.0.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2008",
        "tsup": "^8.0.0",
        "tsx": "^4.21.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
}
