{
    "name": "events",
    "version": "0.0.0",
    "type": "module",
    "private": true,
    "engines": {
        "node": ">= 24"
    },
    "scripts": {
        "test": "StackName='test' tsx --test test/*.test.ts",
        "coverage": "StackName='test' c8 --reporter=lcov --reporter=text tsx --test test/*.test.ts",
        "check": "tsc --noEmit",
        "build": "tsc",
        "prod": "node dist/index.js",
        "lint": "oxlint --type-aware index.ts cli.ts src/ test/",
        "typegen": "npm run typegen -C ../../api"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.787.0",
        "@aws-sdk/lib-storage": "^3.787.0",
        "@aws-sdk/node-http-handler": "^3.370.0",
        "@tak-ps/node-cot": "^14.0.0",
        "@tak-ps/node-safeurl": "^1.4.0",
        "@tak-ps/xml-js": "^2.0.4",
        "glob": "^13.0.0",
        "jsonwebtoken": "^9.0.2",
        "node-stream-zip": "^1.15.0",
        "rimraf": "^6.0.1",
        "sharp": "^0.35.5",
        "undici": "^8.12.4",
        "vinyl": "^3.0.0"
    },
    "devDependencies": {
        "@types/geojson": "^7946.0.16",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/node": "^26.0.0",
        "@types/sinon": "^22.0.0",
        "@types/vinyl": "^2.0.12",
        "@typescript/native": "npm:typescript@^7.0.2",
        "c8": "^12.0.0",
        "oxlint": "^1.94.0",
        "oxlint-tsgolint": "^7.0.2008",
        "sinon": "^22.0.0",
        "tsx": "^4.21.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2"
    }
}
