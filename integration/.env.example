# Base URL of the remote CloudTAK instance to test against (no trailing slash)
CLOUDTAK_URL=https://example.com

# Credentials used to authenticate against the instance
CLOUDTAK_USERNAME=your@email.com
CLOUDTAK_PASSWORD=your-password

# Secondary test user with no mission subscriptions (DS-03, sharing tests)
CLOUDTAK_USERNAME_1=second@email.com
CLOUDTAK_PASSWORD_1=second-password
