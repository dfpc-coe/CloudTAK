+- (BOOL)hasFirstResponderIn:(UIView *)view {
+  if (view.isFirstResponder) {
+    return YES;
+  }
+  for (UIView *subview in view.subviews) {
+    if ([self hasFirstResponderIn:subview]) {
+      return YES;
+    }
+  }
+  return NO;
+}
+
+/**
+ * A keyboard-show notification with no first responder inside the WebView is
+ * not the user typing - iOS posts these for AutoFill UI transitions (e.g. the
+ * password-manager input session tearing down after a login form is submitted
+ * and navigated away). Under `resize: native` such a notification schedules a
+ * deferred frame shrink that no WillHide will ever undo, stranding the WebView
+ * at keyboard height. A real keyboard show always has the focused
+ * WKContentView as first responder before the notification posts.
+ */
+- (BOOL)shouldIgnoreShowWithoutResponderForHeight:(double)height {
+  if (height <= 0.0) return NO;
+  if (self.webView == nil) return NO;
+  return ![self hasFirstResponderIn:self.webView];
+}
