{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "CloudTAK",
    "version": "../package.json",
    "identifier": "io.cloudtak.app",
    "build": {
        "beforeDevCommand": "npm run serve",
        "devUrl": "http://localhost:8080",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": ["deb", "appimage", "nsis", "dmg"],
        "category": "Utility",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "macOS": {
            "infoPlist": "Info.plist"
        }
    }
}
